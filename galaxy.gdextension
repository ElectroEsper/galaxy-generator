[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

; Build with:  cd rust && cargo build --release -p galaxy_gd
; The editor runs debug builds of the game; both point at the release library so one build serves both.
[libraries]
linux.debug.x86_64 = "res://rust/target/release/libgalaxy_gd.so"
linux.release.x86_64 = "res://rust/target/release/libgalaxy_gd.so"
windows.debug.x86_64 = "res://rust/target/release/galaxy_gd.dll"
windows.release.x86_64 = "res://rust/target/release/galaxy_gd.dll"
macos.debug = "res://rust/target/release/libgalaxy_gd.dylib"
macos.release = "res://rust/target/release/libgalaxy_gd.dylib"
